#!/usr/bin/env python3
"""flsend - send packages to Galtzagorriak MINIX over the USB console and
install them.

Usage: flsend [-p /dev/ttyACM0] file.tar ...

Log in as root on the Flipper's console first and leave it at the shell
prompt.  flsend types "pkg get", which starts rz on the Flipper, sends the
files with sz (ZMODEM, from the lrzsz package) and shows pkg's output.
Needs: sudo apt install lrzsz
"""
import argparse
import os
import select
import shutil
import subprocess
import sys
import termios
import time


def drain(fd, secs, until=None):
    out = b""
    end = time.time() + secs
    while time.time() < end:
        if select.select([fd], [], [], 0.1)[0]:
            out += os.read(fd, 4096)
            if until and until in out:
                break
    return out


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("-p", "--port", default="/dev/ttyACM0")
    ap.add_argument("files", nargs="+")
    a = ap.parse_args()
    sz = shutil.which("sz") or shutil.which("lsz")
    if not sz:
        sys.exit("flsend: sz not found (sudo apt install lrzsz)")
    for f in a.files:
        if not os.path.isfile(f):
            sys.exit(f"flsend: {f}: no such file")

    fd = os.open(a.port, os.O_RDWR | os.O_NOCTTY)
    t = termios.tcgetattr(fd)
    t[0] = 0
    t[1] = 0
    t[3] = 0
    t[2] |= termios.CLOCAL | termios.CREAD
    termios.tcsetattr(fd, termios.TCSANOW, t)
    drain(fd, 0.5)
    os.write(fd, b"pkg get\r")
    head = drain(fd, 5, until=b"waiting for packages")
    sys.stdout.write(head.decode("latin-1").replace("\r", ""))
    if b"waiting for packages" not in head:
        sys.exit("\nflsend: no 'pkg get' prompt; are you logged in as root?")
    r = subprocess.run([sz, "-b", "-e"] + a.files, stdin=fd, stdout=fd)
    tail = drain(fd, 20, until=b"# ")
    sys.stdout.write(tail.decode("latin-1").replace("\r", ""))
    os.close(fd)
    sys.exit(r.returncode)


if __name__ == "__main__":
    main()
