# postinst of the base package: cards made before make base-flash (R2b.6)
# lack the line in /etc/rc that binds the programs built into the firmware.
grep 'pkg bind' /etc/rc >/dev/null || {
	(echo '/^update/i'; echo '# Programs built into the firmware (make base-flash): bind them at boot.'
	 echo 'pkg bind /bin/*'; echo '.'; echo 'w'; echo 'q') | ed /etc/rc >/dev/null
	echo "base: /etc/rc now runs pkg bind /bin/* at boot"
}
# Cards made before T8 lack EDITOR/VISUAL in /etc/profile (mined is the
# default editor); /etc/profile is not replaced by an upgrade.
grep '^EDITOR=' /etc/profile >/dev/null || {
	echo 'EDITOR=mined	export EDITOR' >> /etc/profile
	echo 'VISUAL=mined	export VISUAL' >> /etc/profile
	echo "base: /etc/profile now sets EDITOR and VISUAL to mined"
}
# Cards made before T12 lack /rom, /dev/rom and its mount in /etc/rc (the
# default settings in internal flash, spec L.2).  The mount fails quietly
# until a minix-base.bin with the settings image is flashed.
test -d /rom || mkdir /rom
test -b /dev/rom || mknod /dev/rom b 1 6
grep '/dev/rom' /etc/rc >/dev/null || {
	(echo '/^>\/etc\/utmp/a'; echo ''
	 echo '# The default settings, read-only from internal flash (spec L.2).'
	 echo 'mount /dev/rom /rom -r >/dev/null 2>&1'; echo '.'; echo 'w'; echo 'q') | ed /etc/rc >/dev/null
	echo "base: /etc/rc now mounts the default settings on /rom"
}
