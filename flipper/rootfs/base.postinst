# postinst of the base package: cards made before make base-flash (R2b.6)
# lack the line in /etc/rc that binds the programs built into the firmware.
grep 'pkg bind' /etc/rc >/dev/null || {
	(echo '/^update/i'; echo '# Programs built into the firmware (make base-flash): bind them at boot.'
	 echo 'pkg bind /bin/*'; echo '.'; echo 'w'; echo 'q') | ed /etc/rc >/dev/null
	if grep 'pkg bind' /etc/rc >/dev/null
	then echo "base: /etc/rc now runs pkg bind /bin/* at boot"
	else echo "base: could not add pkg bind to /etc/rc; run pkg install again"
	fi
}
# Cards made before T8 lack EDITOR/VISUAL in /etc/profile (mined is the
# default editor); /etc/profile is not replaced by an upgrade.
grep '^EDITOR=' /etc/profile >/dev/null || {
	echo 'EDITOR=mined	export EDITOR' >> /etc/profile
	echo 'VISUAL=mined	export VISUAL' >> /etc/profile
	echo "base: /etc/profile now sets EDITOR and VISUAL to mined"
}
# Cards made before T12 lack /rom, /dev/rom and its mount in /etc/rc (the
# default settings in internal flash, spec L.2).  The mount fails quietly
# until a minix-base.bin with the settings image is flashed.
test -d /rom || mkdir /rom
test -r /dev/rom || mknod /dev/rom b 1 6 || echo "base: could not make /dev/rom"
chmod 755 /rom
grep '/dev/rom' /etc/rc >/dev/null || {
	(echo '/^>\/etc\/utmp/a'; echo ''
	 echo '# The default settings, read-only from internal flash (spec L.2).'
	 echo 'mount /dev/rom /rom -r >/dev/null 2>&1'; echo '.'; echo 'w'; echo 'q') | ed /etc/rc >/dev/null
	if grep '/dev/rom' /etc/rc >/dev/null
	then echo "base: /etc/rc now mounts the default settings on /rom"
	else echo "base: could not add the /rom mount to /etc/rc; run pkg install again"
	fi
}
# Cards made before T15a lack /dev/power (the fuel gauge, read only) and
# the Power app on the launcher; /etc/apps is not replaced by an upgrade.
# (test knows no -c or -b: they are taken as strings, always true.)
test -r /dev/power || mknod /dev/power c 6 8 || echo "base: could not make /dev/power"
chmod 644 /dev/power 2>/dev/null	# R6.1: root writes charger settings
grep '^Power:' /etc/apps >/dev/null || {
	echo 'Power:nobody:@power:/bin/power' >> /etc/apps
	echo "base: the launcher now has Power"
}
# The "RFID emu" entry of part 4 (/bin/rfidemu is gone): drop it whatever
# else the card has.
grep '^RFID emu:' /etc/apps >/dev/null && {
	grep -v '^RFID emu:' /etc/apps > /etc/apps.new && mv /etc/apps.new /etc/apps
	echo "base: RFID emu is now part of the RFID app"
}
grep '^RFID:' /etc/apps >/dev/null || {
	echo 'RFID:nobody:@rfid:/bin/lfrfid' >> /etc/apps
	echo "base: the launcher now has RFID"
}
# R5.6a: the base apps' lines as shipped get their icons (lines the owner
# changed stay as they are).
test -f /etc/apps &&	# a card without its own copy keeps using /rom's
sed -e 's|^Console:nobody:/bin/console$|Console:nobody:@console:/bin/console|' \
    -e 's|^About:nobody:/bin/info$|About:nobody:@info:/bin/info|' \
    -e 's|^Lights:nobody:/bin/lights$|Lights:nobody:@light:/bin/lights|' \
    -e 's|^Power:nobody:/bin/power$|Power:nobody:@power:/bin/power|' \
    -e 's|^RFID:nobody:/bin/lfrfid$|RFID:nobody:@rfid:/bin/lfrfid|' \
    /etc/apps > /etc/apps.new
if test ! -f /etc/apps.new || cmp -s /etc/apps /etc/apps.new
then rm -f /etc/apps.new
else mv /etc/apps.new /etc/apps; echo "base: the launcher's apps have icons"
fi
# Cards made before K.7 do not apply the system settings at boot.
grep 'settings apply' /etc/rc >/dev/null || {
	(echo '/^launcher &/i'
	 echo '# The system settings (spec K.7): /etc/flipper/*.conf applied.'
	 echo 'settings apply'; echo ''; echo '.'; echo 'w'; echo 'q') | ed /etc/rc >/dev/null
	if grep 'settings apply' /etc/rc >/dev/null
	then echo "base: /etc/rc now applies the system settings at boot"
	else echo "base: could not add settings apply to /etc/rc; run pkg install again"
	fi
}
# Cards made before R6.7 lack /dev/ibutton (read a key's ROM).
if test ! -r /dev/ibutton
then
	mknod /dev/ibutton c 6 9 || echo "base: could not make /dev/ibutton"
	chgrp gui /dev/ibutton 2>/dev/null
	chmod 660 /dev/ibutton 2>/dev/null
fi
# Cards made before R7b.1 lack the group timers and /dev/rtc (the RTC
# alarm and calibration; root and group timers).
grep '^timers:' /etc/group >/dev/null || {
	echo 'timers:*:11:' >> /etc/group
	echo "base: /etc/group now has timers"
}
if test ! -r /dev/rtc
then
	mknod /dev/rtc c 6 13 || echo "base: could not make /dev/rtc"
	chgrp timers /dev/rtc 2>/dev/null
	chmod 660 /dev/rtc 2>/dev/null
fi
# Cards made before R6.4 lack /dev/adc (header pin voltages).
if test ! -r /dev/adc
then
	mknod /dev/adc c 6 10 || echo "base: could not make /dev/adc"
	chmod 444 /dev/adc 2>/dev/null
fi
# Cards made before R8.1 lack /dev/subghz (the CC1101, receive only);
# early cards had a placeholder node with /dev/power's number (6, 8).
if ls -l /dev/subghz 2>/dev/null | grep '6, *8 ' >/dev/null
then
	rm -f /dev/subghz
fi
if test ! -r /dev/subghz
then
	mknod /dev/subghz c 6 11 || echo "base: could not make /dev/subghz"
	chgrp gui /dev/subghz 2>/dev/null
	chmod 660 /dev/subghz 2>/dev/null
fi
# Cards made before R4b.7 part 2 lack /dev/subghzraw (what the CC1101
# demodulates, timed).
if test ! -r /dev/subghzraw
then
	mknod /dev/subghzraw c 6 14 || echo "base: could not make /dev/subghzraw"
	chgrp gui /dev/subghzraw 2>/dev/null
	chmod 660 /dev/subghzraw 2>/dev/null
fi
# Cards made before R6.5 lack /dev/rfid (a 125 kHz tag's signal); test
# builds of R6.5 made it minor 15, which is /dev/lat: made again each time.
rm -f /dev/rfid
if test ! -r /dev/rfid
then
	mknod /dev/rfid c 6 16 || echo "base: could not make /dev/rfid"
	chgrp gui /dev/rfid 2>/dev/null
	chmod 660 /dev/rfid 2>/dev/null
fi
# Cards made before R11.3.1 (T28a) lack the group usb and the USB HID
# files (keyboard, mouse, consumer control; root and group usb).
grep '^usb:' /etc/group >/dev/null || {
	echo 'usb:*:12:' >> /etc/group
	echo "base: /etc/group now has usb"
}
if test ! -r /dev/hidkbd
then
	mknod /dev/hidkbd c 6 17 || echo "base: could not make /dev/hidkbd"
	chgrp usb /dev/hidkbd 2>/dev/null
	chmod 660 /dev/hidkbd 2>/dev/null
fi
if test ! -r /dev/hidmouse
then
	mknod /dev/hidmouse c 6 18 || echo "base: could not make /dev/hidmouse"
	chgrp usb /dev/hidmouse 2>/dev/null
	chmod 660 /dev/hidmouse 2>/dev/null
fi
if test ! -r /dev/hidcons
then
	mknod /dev/hidcons c 6 19 || echo "base: could not make /dev/hidcons"
	chgrp usb /dev/hidcons 2>/dev/null
	chmod 660 /dev/hidcons 2>/dev/null
fi
# Cards made before R6.4 part 2 lack /dev/adcs (a pin sampled at a rate).
if test ! -r /dev/adcs
then
	mknod /dev/adcs c 6 12 || echo "base: could not make /dev/adcs"
	chgrp gui /dev/adcs 2>/dev/null
	chmod 660 /dev/adcs 2>/dev/null
fi
# Cards made before Phase 3 (R3.4) keep root's password hash in /etc/passwd,
# readable by everybody: move it to /etc/shadow (mode 600), ##root in its
# place.
if test ! -f /etc/shadow
then
	if grep '^root:##' /etc/passwd >/dev/null
	then :
	else
		>/etc/shadow
		chmod 600 /etc/shadow
		sed -n 's/^root:\([^:]*\):.*/root:\1:0:0::\/:/p' /etc/passwd >>/etc/shadow
		sed 's/^root:[^:]*:/root:##root:/' /etc/passwd >/etc/passwd.new &&
			cp /etc/passwd.new /etc/passwd && rm -f /etc/passwd.new
		echo "base: root's password is now in /etc/shadow"
		grep '^root::' /etc/shadow >/dev/null &&
			echo "base: root has no password: set one with passwd"
	fi
fi
# The sticky bit on /tmp and /usr/tmp (R3.7): chmod dropped it before.
chmod 1777 /tmp
test -d /usr/tmp && chmod 1777 /usr/tmp
