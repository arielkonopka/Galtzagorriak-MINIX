# postinst of the alarm package (spec 7b, F.4).  The app's own user
# (alarm, group timers: it may add timers to /var/timers; spec A.3) and
# its line on the launcher.  The launcher starts it as root; once it has
# the screen and buttons it becomes the user alarm (one gid per process,
# so it cannot get both gui and timers from the launcher yet).
grep '^alarm:' /etc/passwd >/dev/null || {
	echo 'alarm:*:22:11:Alarm clock:/home/flipper:' >> /etc/passwd
	echo "alarm: added the user alarm (uid 22, group timers)"
}
sed -e 's|^Alarm:root:/usr/bin/alarm$|Alarm:root:@alarm:/usr/bin/alarm|' /etc/apps > /etc/apps.new && mv /etc/apps.new /etc/apps
grep '^Alarm:' /etc/apps >/dev/null || {
	echo 'Alarm:root:@alarm:/usr/bin/alarm' >> /etc/apps
	echo "alarm: the launcher now has Alarm"
}
test -d /home/flipper/apps_data/alarm || mkdir /home/flipper/apps_data/alarm
chown alarm /home/flipper/apps_data/alarm
chgrp timers /home/flipper/apps_data/alarm
chmod 700 /home/flipper/apps_data/alarm
