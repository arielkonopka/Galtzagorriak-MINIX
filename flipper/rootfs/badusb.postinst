# postinst of the badusb package (spec R11.3.3, R11.3.4, F.4, K.8).  The
# app's own user badusb (uid 23) in group usb: only that group may open
# the HID device files (R11.3.1).  The launcher line "Bad USB", a window
# app ("=": the launcher starts it as badusb with its pipes on fd 3 and 4).
# The example scripts are files of the package in /ext/badusb
# (/home/flipper/badusb).
#
# Only sh built-ins and small programs here, no subshells: pkg is still
# in memory while this runs, and a larger program (grep, sed, cp) or a
# fork may not fit beside it ("not found", "try again").
# The files are read with exec redirections: a redirected loop would run
# in a forked subshell (its variables lost, and the fork may not fit).
exec 3<&0 </etc/passwd
u=no
while read l
do
	case "$l" in badusb:*) u=yes ;; esac
done
exec </etc/apps
a=no
while read l
do
	case "$l" in *:=/usr/bin/badusb-gui) a=yes ;; esac
done
exec <&3 3<&-
test $u = yes || {
	echo 'badusb:*:23:12:Bad USB:/home/flipper:' >> /etc/passwd
	echo "badusb: added the user badusb (uid 23, group usb)"
}
test $a = yes || {
	echo 'Bad USB:badusb:@usb:=/usr/bin/badusb-gui' >> /etc/apps
	echo "badusb: the launcher now has Bad USB"
}
chmod 755 /home/flipper/badusb
# The settings (K.7): written by the app only when a value changes; an
# empty file is the defaults (en-US, no delay).  It belongs to badusb,
# which may not make files in /etc/flipper.
test -d /etc/flipper || mkdir /etc/flipper
test -f /etc/flipper/badusb.conf || >/etc/flipper/badusb.conf
chown badusb /etc/flipper/badusb.conf
chmod 644 /etc/flipper/badusb.conf
