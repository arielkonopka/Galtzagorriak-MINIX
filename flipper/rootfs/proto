# Root file system for MINIX on the Flipper Zero, MINIX mkfs(1) format.
# Built by tools/mkfsimg.py (make disk).  Host paths are relative to this
# directory of the Makefile; @BINFILES@ = the programs (tools/mkproto.py).
boot
32768 2048
d--755 0 0
   bin d--755 2 0
      @BINFILES@
   $
   dev d--755 0 0
      console c--622 0 0 4 0
      log c--222 0 0 4 15
      tty c--666 0 0 5 0
      null c--666 0 0 1 3
      mem c--640 0 0 1 1
      kmem c--640 0 0 1 2
      ram b--600 0 0 1 0
      hd0 b--600 0 0 3 0
      hd1 b--600 0 0 3 1
      hd2 b--600 0 0 3 2
      hd3 b--600 0 0 3 3
      hd4 b--600 0 0 3 4
   $
   etc d--755 0 0
      motd ---644 0 0 rootfs/etc/motd
      rc ---755 0 0 rootfs/etc/rc
      ttytab ---644 0 0 rootfs/etc/ttytab
      passwd ---644 0 0 rootfs/etc/passwd
      group ---644 0 0 rootfs/etc/group
      profile ---644 0 0 rootfs/etc/profile
      setup ---644 0 0 rootfs/etc/setup
      fstab ---644 0 0 rootfs/etc/fstab
      hostname.file ---644 0 0 rootfs/etc/hostname.file
   $
   tmp d--777 0 0
   $
   usr d--755 0 0
   $
   home d--755 0 0
   $
   lib d--755 0 0
      pkg d--755 0 0
         @PKGFILES@
      $
   $
$
