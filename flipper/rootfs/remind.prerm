# prerm of the remind package: off the launcher.  Its timers in /var/timers,
# its data in /home/flipper/apps_data/remind and the user remind stay (pkg
# install remind brings them back as they were; rm them by hand to forget).
# A new list, then mv (rename) over /etc/apps, never a rewrite in place
# (#282): after a power cut the card has the old list or the new one.
grep -v '^Remind:root:/usr/bin/remind$' /etc/apps | grep -v '^Kanpaia:root:@bell:/usr/bin/remind$' \
	| grep -v '^Kanpaia:remind:@bell:=/usr/bin/remind$' > /etc/apps.new &&
	sync && mv /etc/apps.new /etc/apps
rm -f /etc/apps.new
