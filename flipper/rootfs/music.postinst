# postinst of the music package (issue #420, spec K.8): the Music Player on the launcher.
# Window apps ("=" before the program): the launcher starts them as
# nobody, in group gui, with their pipes on fd 3 and 4.
#
# Only sh built-ins, no subshells, no grep (#271): pkg is still in memory
# while this runs.  /etc/apps is read with an exec redirection (a
# redirected loop would run in a forked subshell).
exec 3<&0 </etc/apps
a=no
while read l
do
	case "$l" in *:=/usr/bin/music) a=yes ;; esac
done
exec <&3 3<&-
test $a = yes || {
	echo 'Music Player:nobody:@music:=/usr/bin/music' >> /etc/apps
	echo "music: the launcher now has Music Player"
}
chmod 755 /home/flipper/music_player
