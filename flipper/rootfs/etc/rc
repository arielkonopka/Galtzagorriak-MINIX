# /etc/rc - system startup for MINIX on the Flipper Zero.
# Run by init before the login prompts.

umask 022
PATH=/bin:/usr/bin
export PATH

. /etc/profile

# Check the file systems that were not left clean (spec N.3), before
# anything writes the card.  fsck -p reads one block and prints nothing
# for a clean one.  The root first: if it was repaired, start again at
# once (the system's copy of it may be older than the repaired card).
. /etc/fstab
fsck_mem=64
test -f /etc/rc.conf && . /etc/rc.conf
fsck -p -v -w 10 -m $fsck_mem $root
case $? in
0|1)	;;
2)	echo "rc: the root file system was repaired: restarting"
	reboot
	exit 0 ;;
*)	echo "rc: errors left on $root: run fsck"
	fsck_err=1 ;;
esac

printroot >/etc/mtab			# /etc/mtab keeps track of mounts
>/etc/utmp				# /etc/utmp keeps track of logins

# The default settings, read-only from internal flash (make base-flash;
# spec L.2): read when a file is not on the SD card (cfcat).
mount /dev/rom /rom -r >/dev/null 2>&1

# First boot: turn the rest of the SD card into /usr, swap and /home.
test -f /etc/.setup-done || sh /etc/setup

# Check /usr and /home before mounting them (spec N.3; Back skips one),
# then mount them (see /etc/fstab).  One with errors left, or not
# checked, is mounted read-only and checked again at the next boot.
# setup -H keeps the copy of /home on the swap partition: no scratch.
scratch="-T /dev/hd3"
test -f /etc/.home-v3 && scratch=
test -f /etc/.setup-done && {
	rm -f /tmp/fsck.log
	for fs in "$usr /usr" "$home /home"
	do
		set $fs
		# swap is still off: past ~30 000 inodes in use fsck keeps
		# its counts on the swap partition (spec O.6)
		fsck -p -v -k -w 5 -m $fsck_mem $scratch -L /tmp/fsck.log $1
		case $? in
		0|1)	mount $1 $2 || echo "rc: cannot mount $1 on $2" ;;
		*)	echo "rc: $1 has errors: mounted read-only, run fsck"
			fsck_err=1
			mount -r $1 $2 || echo "rc: cannot mount $1 on $2" ;;
		esac
	done
	# keep what was found in /usr/adm/fsck.log (at most ~16 KB)
	test -s /tmp/fsck.log && {
		test -d /usr/adm || mkdir /usr/adm
		cat /tmp/fsck.log >>/usr/adm/fsck.log &&
		tail -400 /usr/adm/fsck.log >/tmp/fsck.log &&
		cp /tmp/fsck.log /usr/adm/fsck.log
	}
	rm -f /tmp/fsck.log
}
# setup -H (spec O.7): the next step of converting /home to MINIX V3.
test -f /etc/.home-v3 && sh /etc/setup -Hboot
# The launcher says "Card has errors: run fsck" while this file is there.
if test -n "$fsck_err"; then >/etc/.fsck-errors; else rm -f /etc/.fsck-errors; fi

# Programs built into the firmware's flash (make base-flash): bind them to
# their files the first time (one hash each), then exec finds them directly.
pkg bind /bin/*

# Local settings (sh variables), e.g. fcache_budget=8: the run-time text
# cache may erase at most that many flash pages a day (default 32).  The
# card's /etc/rc.conf first, else the default in /rom.
if test -f /etc/rc.conf; then . /etc/rc.conf
elif test -f /rom/etc/rc.conf; then . /rom/etc/rc.conf
fi
test -n "$fcache_budget" && pkg budget $fcache_budget >/dev/null

# Swap to the SD card's swap partition (spec Phase 12): swap=off|plain|crypt.
# Off while setup -H keeps /home's copy there (/etc/.home-v3).
# plain: no encryption, set-uid programs and Secret: yes packages are never
# swapped.  crypt needs swap encryption (12b), not there yet: off.
case "$swap" in
plain)	test -f /etc/.setup-done && test ! -f /etc/.home-v3 && swapon /dev/hd3 plain &&
		{ test -z "$swap_reserve" || swapon -r $swap_reserve; } ;;
crypt)	echo "rc: swap=crypt is not available yet (no swap encryption): swap is off" ;;
esac

# The radio region (spec R8.2): the Sub-GHz transmit bands; set once per
# boot, a transmit is refused until it is.  /etc/flipper/region holds the
# country code (PL, ES, FR, IE, FI, SE, NO, GB, AL, US, CA or EU; spec
# section Q); no file, or a country without a table: no transmit.
test -r /etc/flipper/region && test -x /usr/bin/subghz &&
	/usr/bin/subghz region `cat /etc/flipper/region`

# Flush the buffer cache to the SD card every 30 seconds.
update &

cfcat /etc/motd 2>/dev/null

# The system settings (spec K.7): /etc/flipper/*.conf applied (brightness,
# idle timeout, volume); a missing file keeps the defaults.
settings apply

# The main screen: replaces the boot screen on the LCD (runs as root, starts
# the apps from /etc/apps with their own user rights).
launcher &
