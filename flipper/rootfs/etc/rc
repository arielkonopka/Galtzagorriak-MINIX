# /etc/rc - system startup for MINIX on the Flipper Zero.
# Run by init before the login prompts.  One file system: / on /dev/hd1.

umask 022
PATH=/bin:/usr/bin
export PATH

. /etc/profile

printroot >/etc/mtab			# /etc/mtab keeps track of mounts
>/etc/utmp				# /etc/utmp keeps track of logins

# Flush the buffer cache to the SD card every 30 seconds.
update &

cat /etc/motd
