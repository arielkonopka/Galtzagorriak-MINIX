# /etc/rc - system startup for MINIX on the Flipper Zero.
# Run by init before the login prompts.

umask 022
PATH=/bin:/usr/bin
export PATH

. /etc/profile

printroot >/etc/mtab			# /etc/mtab keeps track of mounts
>/etc/utmp				# /etc/utmp keeps track of logins

# The default settings, read-only from internal flash (make base-flash;
# spec L.2): read when a file is not on the SD card (cfcat).
mount /dev/rom /rom -r >/dev/null 2>&1

# First boot: turn the rest of the SD card into /usr, swap and /home.
test -f /etc/.setup-done || sh /etc/setup

# Mount /usr and /home (see /etc/fstab).
. /etc/fstab
test -f /etc/.setup-done && {
	mount $usr /usr || echo "rc: cannot mount $usr on /usr"
	mount $home /home || echo "rc: cannot mount $home on /home"
}

# Programs built into the firmware's flash (make base-flash): bind them to
# their files the first time (one hash each), then exec finds them directly.
pkg bind /bin/*

# Local settings (sh variables), e.g. fcache_budget=8: the run-time text
# cache may erase at most that many flash pages a day (default 32).  The
# card's /etc/rc.conf first, else the default in /rom.
if test -f /etc/rc.conf; then . /etc/rc.conf
elif test -f /rom/etc/rc.conf; then . /rom/etc/rc.conf
fi
test -n "$fcache_budget" && pkg budget $fcache_budget >/dev/null

# Swap to the SD card's swap partition (spec Phase 12): swap=off|plain|crypt.
# plain: no encryption, set-uid programs and Secret: yes packages are never
# swapped.  crypt needs swap encryption (12b), not there yet: off.
case "$swap" in
plain)	test -f /etc/.setup-done && swapon /dev/hd3 plain &&
		{ test -z "$swap_reserve" || swapon -r $swap_reserve; } ;;
crypt)	echo "rc: swap=crypt is not available yet (no swap encryption): swap is off" ;;
esac

# Flush the buffer cache to the SD card every 30 seconds.
update &

cfcat /etc/motd 2>/dev/null

# The system settings (spec K.7): /etc/flipper/*.conf applied (brightness,
# idle timeout, volume); a missing file keeps the defaults.
settings apply

# The main screen: replaces the boot screen on the LCD (runs as root, starts
# the apps from /etc/apps with their own user rights).
launcher &
