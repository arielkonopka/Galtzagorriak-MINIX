# Apps on the launcher's main screen, one per line:
#	Label:user:/program arg ...
#	Label:user:icon:/program arg ...
# icon: @name (built in: app console info light power battery rfid nfc
# subghz ir ibutton gpio usb ble clock alarm bell timer sensor game music
# tools file settings), # and 12 hex digits (8x6 pixels, a byte a row,
# top first), 1-2 characters, or empty.  Apps run as the given user, in
# group "gui" (screen, buttons, LED).
# Folders (#461): "[Label:icon]" starts a folder, the lines after it are
# in it, "[]" ends it (one level; Back goes up).  Lists stay short.
Archive:nobody:@file:=/bin/archive
Sub-GHz:nobody:@subghz:=/bin/subghzui
RFID:nobody:@rfid:/bin/lfrfid
NFC:nobody:@nfc:=/bin/nfc
Infrared:nobody:@ir:/bin/infrared
iButton:nobody:@ibutton:=/bin/ibuttonui
[Tools:@tools]
Sub-GHz Remote:nobody:@subghz:=/bin/subrem
Spectrum:nobody:@subghz:/bin/spectrum
GPIO:nobody:@gpio:=/bin/gpioui
Snake:nobody:@game:=/bin/snakeui
[System:@settings]
Console:nobody:@console:/bin/console
Lights:nobody:@light:/bin/lights
Power:nobody:@power:/bin/power
Charging:nobody:@battery:/bin/chargescreen
About:nobody:@info:/bin/info
[]
